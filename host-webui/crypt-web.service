[Unit]
Description=CRYPT S2 Smart Home Processor BETA1
After=network-online.target crypt-pulse.service crypt-hostname.service
Wants=network-online.target crypt-pulse.service crypt-hostname.service

[Service]
Type=simple
User=RPM
Group=audio
WorkingDirectory=/data/www
ExecStart=/usr/bin/python3 /data/www/server.py
Restart=always
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Environment=WEBUI_PORT=80
Environment=MUSIC_DIR=/data/music
Environment=PULSE_SERVER=unix:/run/pulse/native
Environment=PULSE_SINK=@DEFAULT_SINK@
Environment=SSC_HOST=192.168.1.136
Environment=SSC_PORT=23
Environment=SSC14_HOST=192.168.1.136
Environment=SSC12_HOST=192.168.1.138

[Install]
WantedBy=multi-user.target
